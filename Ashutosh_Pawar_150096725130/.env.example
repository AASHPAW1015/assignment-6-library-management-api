# Copy to .env and fill in.

# port the API listens on
PORT=5000

# secret used to sign JWT tokens -- make it long and random
JWT_SECRET=change_me_to_a_long_random_string

# secret a person must supply to register as a librarian
LIBRARIAN_SECRET_KEY=super-secret-librarian-key

# --- Firebase Admin credentials ---
# EITHER drop the downloaded serviceAccountKey.json in this folder (preferred),
# OR paste the whole JSON on one line below (handy for hosts like Render).
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...", ...}
